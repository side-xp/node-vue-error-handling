{
  "name": "@side-xp/vue-error-handling",
  "version": "0.0.0",
  "description": "Handles the routing and component errors of a Vue app at the closest level possible, so they never fail silently.",
  "keywords": [
    "vue",
    "vue-router",
    "error",
    "error-handling",
    "error-boundary"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/side-xp/node-vue-error-handling.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "npm run biome:check && npm run verify",
    "fix": "npm run biome:fix",
    "verify": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "playground:preview": "vite preview playground",
    "playground-webpack:build": "webpack --config playground-webpack/webpack.config.mjs",
    "playground-webpack:preview": "vite preview playground-webpack --port 4174",
    "check:package": "publint --strict && attw --pack --ignore-rules cjs-resolves-to-esm",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check:package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@side-xp/biome-config": "^1.2.1",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.0.4",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.3",
    "ts-loader": "^9.6.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-loader": "^17.4.2",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
