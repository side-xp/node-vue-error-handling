{
  "name": "@todo/my-package",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "npm run biome:check && npm run verify",
    "fix": "npm run biome:fix",
    "verify": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:package": "publint --strict && attw --pack --ignore-rules cjs-resolves-to-esm",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check:package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@side-xp/biome-config": "^1.2.1",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "~7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  }
}
